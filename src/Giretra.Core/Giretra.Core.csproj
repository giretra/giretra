<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <!-- System.Collections.Immutable is part of the BCL on net10.0 but a package on netstandard2.1 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.Collections.Immutable" Version="10.0.11" />
  </ItemGroup>

  <!-- Bot-hosting infrastructure (process spawning, HTTP, discovery) is excluded from the
       netstandard2.1 build consumed by the Unity client; only .NET 10 hosts use it. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <Compile Remove="Players/Agents/Remote/**/*.cs" />
    <Compile Remove="Players/Discovery/**/*.cs" />
    <Compile Remove="Players/Factories/RemotePlayerAgentFactory.cs" />
    <Compile Remove="Players/Factories/LocalWsPlayerAgentFactory.cs" />
  </ItemGroup>

</Project>
