{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MobileClient": {
    "MinSupportedVersion": "0.1.0",
    "LatestVersion": "0.1.0",
    "StoreUrls": {
      "Android": null,
      "Ios": null
    }
  },
  "Feedback": {
    "GitHubIssuesUrl": "https://github.com/giretra/giretra/issues/new/choose",
    "ExtraRecipients": [],
    "Smtp": {
      "Host": null,
      "Port": 587,
      "User": null,
      "Password": null,
      "From": null
    }
  },
  "Keycloak": {
    "Authority": "https://auth.giretra.com/realms/giretra",
    "Audience": "giretra-api",
    "RequireHttpsMetadata": true
  }
